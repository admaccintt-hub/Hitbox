local function getSkinModules()
    local modules = ReplicatedStorage:FindFirstChild("SkinModules")
    if not modules then return nil end
    local ok, result = pcall(require, modules)
    if ok then return result end
    warn("[Glory] Could not load SkinModules:", result)
    return nil
end

local function getGunSkinNames(toolName)
    local data = getSkinModules()
    local list = {}
    if data and type(data[toolName]) == "table" then
        for name in pairs(data[toolName]) do
            if type(name) == "string" then table.insert(list, name) end
        end
    end
    table.sort(list)
    return list
end

local function refreshGunCategories()
    skinCategories["Double Barrel"] = getGunSkinNames("[Double-Barrel SG]")
    skinCategories["Revolver"] = getGunSkinNames("[Revolver]")
    skinCategories["Tactical Shotgun"] = getGunSkinNames("[TacticalShotgun]")
end

local function clearMesh(tool, exclude)
    for _, v in ipairs(tool:GetChildren()) do
        if v:IsA("MeshPart") and v ~= exclude then v:Destroy() end
    end
end

local function restoreGun(tool)
    local saved = gunOriginals[tool]
    if not saved then
        local handle = tool:FindFirstChild("Handle")
        if handle then
            handle:SetAttribute("SkinName", nil)
        end
        return
    end
    local orig = saved.orig
    if saved.currentSkin and saved.currentSkin.Parent then saved.currentSkin:Destroy() end
    if orig and orig.Parent then
        orig.TextureID = saved.texture
        orig.Transparency = saved.transparency
    end
    if saved.shoot and saved.shoot.Parent then saved.shoot.SoundId = saved.soundId end
    if saved.handle and saved.handle.Parent then
        for _, child in ipairs(saved.handle:GetChildren()) do
            if child:IsA("ParticleEmitter") and child:GetAttribute("GloryCreated") then child:Destroy() end
        end
        saved.handle:SetAttribute("SkinName", nil)
    end
    gunOriginals[tool] = nil
end

local function applyGun(tool, skinName)
    local orig = tool:FindFirstChildOfClass("MeshPart")
    if not orig then warn("[Glory] No MeshPart in", tool.Name); return false end
    local skinModules = getSkinModules()
    if not skinModules then warn("[Glory] SkinModules not found"); return false end
    local weaponData = skinModules[tool.Name]
    local info = weaponData and weaponData[skinName]
    if not info then warn("[Glory] Skin not found for", tool.Name, skinName); return false end

    restoreGun(tool)
    local handle = tool:FindFirstChild("Handle")
    local shoot = handle and handle:FindFirstChild("ShootSound")
    gunOriginals[tool] = {
        orig=orig, texture=orig.TextureID, transparency=orig.Transparency,
        handle=handle, shoot=shoot, soundId=shoot and shoot.SoundId or nil,
    }
    local saved = gunOriginals[tool]
    clearMesh(tool, orig)
    local skinPart = info.TextureID
    if typeof(skinPart) == "Instance" then
        local clone = skinPart:Clone()
        clone.Parent = tool
        clone.CFrame = orig.CFrame
        clone.Name = "GloryCurrentSkin"
        local weld = Instance.new("Weld")
        weld.Part0 = clone
        weld.Part1 = orig
        weld.C0 = info.CFrame and info.CFrame:Inverse() or CFrame.new()
        weld.Parent = clone
        orig.Transparency = 1
        saved.currentSkin = clone
    else
        orig.TextureID = skinPart or orig.TextureID
        orig.Transparency = 0
    end

    if handle then
        local assets = ReplicatedStorage:FindFirstChild("SkinAssets")
        local gunSounds = assets and assets:FindFirstChild("GunShootSounds")
        local soundFolder = gunSounds and gunSounds:FindFirstChild(tool.Name)
        local soundValue = soundFolder and soundFolder:FindFirstChild(skinName)
        if shoot and soundValue and soundValue:IsA("StringValue") then shoot.SoundId = soundValue.Value end

        local particles = assets and assets:FindFirstChild("GunHandleParticle")
        local source = particles and particles:FindFirstChild(skinName)
        local emitter = source and source:FindFirstChild("ParticleEmitter")
        if emitter then
            local newEmitter = emitter:Clone()
            newEmitter:SetAttribute("GloryCreated", true)
            newEmitter.Parent = handle
        end
        handle:SetAttribute("SkinName", skinName)
    end
    return true
end

local function cleanKnife(tool)
    local data = knifeData[tool]
    if data then
        if data.track then pcall(function() data.track:Stop(); data.track:Destroy() end) end
        for _, w in ipairs(data.welds or {}) do if w and w.Parent then w:Destroy() end end
        for _, s in ipairs(data.sounds or {}) do if s and s.Parent then s:Destroy() end end
    end
    local mesh = tool:FindFirstChild("Default")
    if mesh then
        for _, v in ipairs(mesh:GetChildren()) do
            if v.Name == "Handle.R" or v:IsA("Model") or (v:IsA("BasePart") and v.Name ~= "Default") then
                v:Destroy()
            end
        end
        mesh.Transparency = 0
    end
    knifeData[tool] = nil
    tool:SetAttribute("CurrentKnifeSkin", nil)
end

local function applyKnife(char, tool, skinName)
    local skinConfig = gloryKnifeSkins[skinName]
    if not skinConfig then warn("[Glory] Knife config missing:", skinName); return false end
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hand = char and (char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm"))
    if not hum or not hand then warn("[Glory] Character hand or Humanoid not found"); return false end
    local mesh = tool:FindFirstChild("Default")
    if not mesh then warn("[Glory] Knife Default part not found"); return false end
    local skinModules = ReplicatedStorage:FindFirstChild("SkinModules")
    local knives = skinModules and skinModules:FindFirstChild("Knives")
    local skinModel = knives and knives:FindFirstChild(skinName)
    if not skinModel then warn("[Glory] Knife model missing in SkinModules.Knives:", skinName); return false end

    cleanKnife(tool)
    knifeData[tool] = {track=nil, welds={}, sounds={}}
    local data = knifeData[tool]
    mesh.Transparency = 1
    local clone = skinModel:Clone()
    clone.Name = "Glory_" .. skinName

    local handR = Instance.new("Part")
    handR.Name = "Handle.R"
    handR.Transparency = 1
    handR.CanCollide = false
    handR.Anchored = false
    handR.Size = Vector3.new(0.05,0.05,0.05)
    handR.Massless = true
    handR.Parent = mesh
    local m6d = Instance.new("Motor6D")
    m6d.Name = "Handle.R"
    m6d.Part0 = hand
    m6d.Part1 = handR
    m6d.Parent = handR

    local offset = CFrame.new(skinConfig.positionoffset) * CFrame.Angles(math.rad(skinConfig.rotationoffset.X), math.rad(skinConfig.rotationoffset.Y), math.rad(skinConfig.rotationoffset.Z))
    local parts = {}
    if clone:IsA("Model") then
        if not clone.PrimaryPart then
            local first = clone:FindFirstChildWhichIsA("BasePart", true)
            if first then clone.PrimaryPart = first end
        end
        if clone.PrimaryPart then
            for _, part in ipairs(clone:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false; part.Massless = true; part.Anchored = false
                    local weld = Instance.new("Weld")
                    weld.Part0 = handR; weld.Part1 = part
                    weld.C0 = offset
                    weld.C1 = part.CFrame:ToObjectSpace(clone.PrimaryPart.CFrame)
                    weld.Parent = part
                    table.insert(data.welds, weld)
                    table.insert(parts, part)
                end
            end
        end
        clone.Parent = mesh
    elseif clone:IsA("BasePart") then
        clone.CanCollide = false; clone.Massless = true; clone.Anchored = false
        if clone:IsA("MeshPart") and skinConfig.textureid then clone.TextureID = skinConfig.textureid end
        clone.Parent = mesh
        local weld = Instance.new("Weld")
        weld.Part0 = handR; weld.Part1 = clone; weld.C0 = offset; weld.Parent = clone
        table.insert(data.welds, weld)
        table.insert(parts, clone)
    else
        clone:Destroy()
        cleanKnife(tool)
        return false
    end

    if skinConfig.particle and #parts > 0 then
        local assets = ReplicatedStorage:FindFirstChild("SkinAssets")
        local folder = assets and assets:FindFirstChild("GunHandleParticle")
        local source = folder and folder:FindFirstChild(skinName)
        local emitter = source and source:FindFirstChild("ParticleEmitter")
        if emitter then emitter:Clone().Parent = parts[1] end
    end

    local animator = hum:FindFirstChildOfClass("Animator")
    if not animator then animator = Instance.new("Animator"); animator.Parent = hum end
    if skinConfig.animationid and skinConfig.animationid ~= "" then
        local anim = Instance.new("Animation")
        anim.AnimationId = skinConfig.animationid
        local ok, track = pcall(function() return animator:LoadAnimation(anim) end)
        anim:Destroy()
        if ok and track then
            track.Looped = false
            track:Play()
            data.track = track
            track.Ended:Once(function()
                if data.track == track then data.track = nil end
                pcall(function() track:Destroy() end)
            end)
        end
    end
    if skinConfig.soundid and skinConfig.soundid ~= "" then
        local sound = Instance.new("Sound")
        sound.SoundId = skinConfig.soundid
        sound.Parent = Workspace
        sound:Play()
        table.insert(data.sounds, sound)
        sound.Ended:Connect(function() if sound.Parent then sound:Destroy() end end)
    end
    tool:SetAttribute("CurrentKnifeSkin", skinName)
    return true
end

local function equipTool(tool, category, skinName)
    if not tool or not tool:IsA("Tool") then return false, "Tool not found" end
    if category == "Knife" then
        local char = player.Character
        if not char or tool.Parent ~= char then return false, "Сначала достань Knife" end
        return applyKnife(char, tool, skinName), "Knife"
    else
        if tool.Parent ~= player.Character then return false, "Сначала достань оружие" end
        return applyGun(tool, skinName), "Gun"
    end
end

local function unequipToolSkin(tool, category)
    if not tool then return false, "Сначала достань оружие" end
    if category == "Knife" then cleanKnife(tool) else restoreGun(tool) end
    cfg.skins.weapons[tool.Name] = nil
    return true, "Скин снят"
end



-- Skin changer tool tracking (integrated into Hailey's Guns tab)
local function setupGloryTool(tool)
    if not tool:IsA("Tool") or toolRegistry[tool] then return end
    toolRegistry[tool] = true
    tool.Equipped:Connect(function()
        if not cfg.skins.enabled then return end
        local skinName = cfg.skins.weapons[tool.Name]
        if not skinName then return end
        task.defer(function()
            if tool.Name == "[Knife]" then
                if player.Character then applyKnife(player.Character, tool, skinName) end
            else
                applyGun(tool, skinName)
            end
        end)
    end)
    tool.Unequipped:Connect(function()
        if tool.Name == "[Knife]" then cleanKnife(tool) end
    end)
end

local function watchGloryCharacter(char)
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Tool") then setupGloryTool(child) end
    end
    char.ChildAdded:Connect(function(child)
        if child:IsA("Tool") then setupGloryTool(child) end
    end)
end

