local function syncToggleLockPosition()
    toggleLock.Position = UDim2.new(menuToggle.Position.X.Scale, menuToggle.Position.X.Offset + menuToggle.AbsoluteSize.X + 4,
        menuToggle.Position.Y.Scale, menuToggle.Position.Y.Offset)
end
syncToggleLockPosition()
toggleLock.MouseButton1Click:Connect(function()
    toggleLocked = not toggleLocked
    toggleLock.Text = toggleLocked and "🔒" or "🔓"
    toggleLock.BackgroundColor3 = toggleLocked and Color3.fromRGB(25, 105, 190) or Color3.fromRGB(45, 145, 225)
end)

menuToggle.MouseButton1Click:Connect(function()
    if toggleMoved then
        toggleMoved = false
        return
    end
    mainFrame.Visible = not mainFrame.Visible
end)

local toggleDragging = false
local toggleDragStart, toggleStartPosition, toggleDragInput
menuToggle.InputBegan:Connect(function(input)
    if toggleLocked then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        toggleDragging = true
        toggleMoved = false
        toggleDragStart = input.Position
        toggleStartPosition = menuToggle.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then toggleDragging = false end
        end)
    end
end)
menuToggle.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        toggleDragInput = input
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if toggleDragging and not toggleLocked and input == toggleDragInput then
        local delta = input.Position - toggleDragStart
        if math.abs(delta.X) > 4 or math.abs(delta.Y) > 4 then toggleMoved = true end
        menuToggle.Position = UDim2.new(
            toggleStartPosition.X.Scale, toggleStartPosition.X.Offset + delta.X,
            toggleStartPosition.Y.Scale, toggleStartPosition.Y.Offset + delta.Y
        )
        syncToggleLockPosition()
    end
end)

