end

local function makeLabel(parent, text, position, size)
    local label = Instance.new("TextLabel")
    label.Size = size or UDim2.new(1, 0, 0, 30)
    label.Position = position or UDim2.new()
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(25, 35, 45)
    label.TextSize = 14
    label.Font = Enum.Font.Gotham
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = 3
    label.Parent = parent
    return label
end

local function makeToggle(parent, text, position, initial, callback)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, 0, 0, 32)
    button.Position = position
    button.ZIndex = 3
    button.TextSize = 13
    button.Font = Enum.Font.GothamBold
    button.TextColor3 = Color3.fromRGB(25, 35, 45)
    button.BorderSizePixel = 0
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = button
    local state = initial
    local function refresh()
        button.Text = text .. (state and ": ON" or ": OFF")
        button.BackgroundColor3 = state and Color3.fromRGB(145, 210, 240) or Color3.fromRGB(220, 238, 248)
    end
    refresh()
    button.Parent = parent
    button.MouseButton1Click:Connect(function()
        state = not state
        refresh()
        callback(state)
    end)
    return button
end

local function makeInput(parent, labelText, value, y, callback)
    makeLabel(parent, labelText, UDim2.new(0, 0, 0, y), UDim2.new(0.6, 0, 0, 30))
    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0.35, 0, 0, 27)
    box.Position = UDim2.new(0.65, 0, 0, y + 1)
    box.BackgroundColor3 = Color3.fromRGB(245, 250, 252)
    box.BackgroundTransparency = 0.1
    box.Text = tostring(value)
    box.TextColor3 = Color3.fromRGB(25, 35, 45)
    box.PlaceholderText = labelText
    box.PlaceholderColor3 = Color3.fromRGB(90, 100, 110)
    box.TextSize = 14
    box.Font = Enum.Font.Gotham
    box.ClearTextOnFocus = false
    box.ZIndex = 3
    box.Parent = parent
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 4)
    corner.Parent = box
    box.FocusLost:Connect(function()
        local number = tonumber(box.Text)
        if number then
            callback(number)
            box.Text = tostring(number)
        else
            box.Text = tostring(value)
        end
    end)
    return box
end

