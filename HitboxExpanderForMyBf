local function styleButton(button, color)
    button.BackgroundColor3 = color or Color3.fromRGB(245, 250, 252)
    button.TextColor3 = Color3.fromRGB(255, 255, 255)
    button.TextSize = 12
    button.Font = Enum.Font.GothamSemibold
