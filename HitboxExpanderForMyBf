    scroll.ScrollBarThickness = 5
    scroll.BackgroundTransparency = 1
    scroll.BorderSizePixel = 0
    scroll.ZIndex = 3
    scroll.Parent = contentFrame

    local originalLighting = {
        FogStart = Lighting.FogStart,
        FogEnd = Lighting.FogEnd,
        FogColor = Lighting.FogColor
    }

    -- Presets copied from the Atmosphere section of pwd2 lock.txt.
    local fogPresets = {
        {"Red", Color3.fromRGB(255, 60, 60), 0.45},
        {"Light Red", Color3.fromRGB(255, 120, 120), 0.44},
        {"Dark Red", Color3.fromRGB(180, 20, 20), 0.48},
        {"Orange", Color3.fromRGB(255, 140, 0), 0.43},
        {"Light Orange", Color3.fromRGB(255, 190, 80), 0.42},
        {"Dark Orange", Color3.fromRGB(200, 90, 0), 0.46},
        {"Yellow", Color3.fromRGB(255, 240, 60), 0.41},
        {"Lime", Color3.fromRGB(140, 255, 60), 0.45},
        {"Green", Color3.fromRGB(50, 255, 50), 0.49},
        {"Cyan", Color3.fromRGB(60, 255, 220), 0.47},
        {"Electric Blue", Color3.fromRGB(0, 255, 255), 0.51},
        {"Blue", Color3.fromRGB(60, 140, 255), 0.50},
        {"Purple", Color3.fromRGB(180, 60, 255), 0.52},
        {"Violet", Color3.fromRGB(138, 43, 226), 0.56},
        {"Pink", Color3.fromRGB(255, 100, 200), 0.48},
        {"Hot Pink", Color3.fromRGB(255, 20, 147), 0.49}
    }

    local resetButton = Instance.new("TextButton")
    resetButton.Size = UDim2.new(1, -4, 0, 30)
    resetButton.Position = UDim2.new(0, 2, 0, 0)
    resetButton.Text = "Reset Lighting"
    resetButton.ZIndex = 4
    styleButton(resetButton, TAB_BLUE_ACTIVE)
    resetButton.Parent = scroll
    resetButton.MouseButton1Click:Connect(function()
        for _, item in ipairs(Lighting:GetChildren()) do
            if item:IsA("Atmosphere") then item:Destroy() end
        end
        Lighting.FogStart = originalLighting.FogStart
        Lighting.FogEnd = originalLighting.FogEnd
        Lighting.FogColor = originalLighting.FogColor
    end)

    for i, preset in ipairs(fogPresets) do
        local button = Instance.new("TextButton")
        button.Size = UDim2.new(0.5, -5, 0, 29)
        local col = (i - 1) % 2
        local row = math.floor((i - 1) / 2)
        button.Position = UDim2.new(col * 0.5, col == 0 and 2 or 3, 0, 35 + row * 32)
        button.Text = preset[1]
        button.ZIndex = 4
        styleButton(button, TAB_BLUE)
        button.Parent = scroll
        button.MouseButton1Click:Connect(function()
            for _, item in ipairs(Lighting:GetChildren()) do
                if item:IsA("Atmosphere") then item:Destroy() end
            end
            local atmosphere = Instance.new("Atmosphere")
            atmosphere.Color = preset[2]
            atmosphere.Density = preset[3]
            atmosphere.Haze = 4
            atmosphere.Parent = Lighting
            Lighting.FogStart = 30
            Lighting.FogEnd = 200
        end)
    end

    local correctionToggle = Instance.new("TextButton")
    correctionToggle.Size = UDim2.new(1, -4, 0, 30)
    correctionToggle.Position = UDim2.new(0, 2, 0, 35 + math.ceil(#fogPresets / 2) * 32)
    correctionToggle.ZIndex = 4
    styleButton(correctionToggle, TAB_BLUE_ACTIVE)
    correctionToggle.Parent = scroll
    local correctionEnabled = false
    local function refreshCorrectionLabel()
        correctionToggle.Text = "Color Correction: " .. (correctionEnabled and "ON" or "OFF")
    end
    refreshCorrectionLabel()
    correctionToggle.MouseButton1Click:Connect(function()
        correctionEnabled = not correctionEnabled
        local effect = Lighting:FindFirstChild("ValColorEffect")
        if correctionEnabled then
            if not effect then effect = Instance.new("ColorCorrectionEffect") end
            effect.Name = "ValColorEffect"
            effect.Enabled = true
            effect.Saturation = 0.5
            effect.Contrast = 0
            effect.Brightness = 0
            effect.TintColor = Color3.fromRGB(255, 255, 255)
            effect.Parent = Lighting
        elseif effect then
            effect.Enabled = false
        end
