-- Make menu draggable by dragging its title
local dragging = false
local dragInput, dragStart, startPosition

title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPosition = mainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)

title.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and input == dragInput then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(startPosition.X.Scale, startPosition.X.Offset + delta.X,
            startPosition.Y.Scale, startPosition.Y.Offset + delta.Y)
    end
end)

-- Speed keybind: capture a replacement key or toggle Speed Master activity.
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

    if waitingForSpeedKey then
        if input.KeyCode ~= Enum.KeyCode.Unknown then
            udhl_settings.SpeedKey = input.KeyCode
            waitingForSpeedKey = false
            if speedKeyCaptureButton and speedKeyCaptureButton.Parent then
                speedKeyCaptureButton.Text = input.KeyCode.Name
            end
        end
        return
    end

    if waitingForCFrameKey then
        if input.KeyCode ~= Enum.KeyCode.Unknown then
            udhl_settings.CFrameSpeedKey = input.KeyCode
            waitingForCFrameKey = false
            if cframeKeyCaptureButton and cframeKeyCaptureButton.Parent then
                cframeKeyCaptureButton.Text = input.KeyCode.Name
            end
        end
        return
    end

    if gameProcessed then return end
    if UserInputService:GetFocusedTextBox() then return end
    if input.KeyCode == udhl_settings.SpeedKey and udhl_settings.SpeedMaster then
        udhl_settings.SpeedActive = not udhl_settings.SpeedActive
    end
    if input.KeyCode == udhl_settings.CFrameSpeedKey then
        udhl_settings.CFrameSpeed = not udhl_settings.CFrameSpeed
    end
end)

-- Movement and character settings loop
local noclipConnection
local lastNoclipState = nil
local function refreshNoclip()
    if noclipConnection then
        noclipConnection:Disconnect()
        noclipConnection = nil
    end
    if udhl_settings.Noclip then
        noclipConnection = RunService.Stepped:Connect(function()
            local character = player.Character
            if character then
                for _, part in ipairs(character:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end
            end
        end)
    end
end

-- Speed Master logic follows pwd2 lock.txt: apply WalkSpeed while enabled and activated by key.
RunService.Heartbeat:Connect(function()
    if udhl_settings.SpeedMaster and udhl_settings.SpeedActive and player.Character then
        local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
        if humanoid and humanoid.WalkSpeed ~= udhl_settings.SpeedValue then
            humanoid.WalkSpeed = udhl_settings.SpeedValue
        end
    end
end)

RunService.RenderStepped:Connect(function()
    if lastNoclipState ~= udhl_settings.Noclip then
        lastNoclipState = udhl_settings.Noclip
        refreshNoclip()
    end
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if root and humanoid and udhl_settings.CFrameSpeed and humanoid.MoveDirection.Magnitude > 0 then
        root.CFrame = root.CFrame + humanoid.MoveDirection * (udhl_settings.SpeedValue / 10)
    end
    if not udhl_settings.Disabled then
        for _, otherPlayer in ipairs(Players:GetPlayers()) do
            if otherPlayer ~= player then
                local otherCharacter = otherPlayer.Character
                local otherRoot = otherCharacter and otherCharacter:FindFirstChild("HumanoidRootPart")
                if otherRoot then
                    pcall(function()
                        otherRoot.Size = Vector3.new(udhl_settings.HeadSize, udhl_settings.HeadSize, udhl_settings.HeadSize)
                        otherRoot.Transparency = udhl_settings.Transparency
                        otherRoot.BrickColor = BrickColor.new("Really blue")
                        otherRoot.Material = Enum.Material.Neon
                        otherRoot.CanCollide = false
                    end)
                end
            end
        end
    end
end)
