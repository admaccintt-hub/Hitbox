    styleButton(equipButton, Color3.fromRGB(45, 145, 100))
    equipButton.Parent = frame

    local unequipButton = Instance.new("TextButton")
    unequipButton.Name = "UnequipSkin"
    unequipButton.Size = UDim2.new(0.5, -3, 0, 29)
    unequipButton.Position = UDim2.new(0.5, 3, 0, 216)
    unequipButton.Text = "UNEQUIP"
    unequipButton.ZIndex = 5
    styleButton(unequipButton, Color3.fromRGB(205, 85, 95))
    unequipButton.Parent = frame

    local function getSelectedTool()
        local character = player.Character
        if not character then return nil end
        for _, child in ipairs(character:GetChildren()) do
            if child:IsA("Tool") and child.Name == categoryToolNames[selectedSkinCategory] then
                return child
            end
        end
        return nil
    end

    equipButton.MouseButton1Click:Connect(function()
        if not selectedSkinName then status.Text = "Choose a skin first."; return end
        local tool = getSelectedTool()
        if not tool then
            status.Text = "Draw " .. categoryToolNames[selectedSkinCategory] .. " first."
            return
        end
        local ok, message = equipTool(tool, selectedSkinCategory, selectedSkinName)
        if ok then
            cfg.skins.weapons[tool.Name] = selectedSkinName
            status.Text = "Equipped: " .. selectedSkinName .. " (local visual only)"
        else
            status.Text = tostring(message or "Could not equip. Check Output.")
        end
    end)

    unequipButton.MouseButton1Click:Connect(function()
        local tool = getSelectedTool()
        if not tool then status.Text = "Draw the matching weapon first."; return end
        local ok, message = pcall(function()
            return unequipToolSkin(tool, selectedSkinCategory)
        end)
        if ok then status.Text = "Skin removed (local visual only)." else status.Text = "Unequip error: " .. tostring(message) end
    end)

    rebuildList()
end


