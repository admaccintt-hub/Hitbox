-- Functional NameTags ESP: creates a BillboardGui above every other player's character.
local NAMETAG_GUI_NAME = "UDHL_NameTag"
local nametagEnabled = false
local nametagPlayerConnections = {}
local nametagAddedConnection = nil
local nametagRemovingConnection = nil

local function removeNametag(character)
    if not character then return end
    local existing = character:FindFirstChild(NAMETAG_GUI_NAME)
    if existing then existing:Destroy() end
end

local function addNametag(targetPlayer)
    if not nametagEnabled or targetPlayer == player then return end
    local character = targetPlayer.Character
    if not character then return end
    local adornee = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
    if not adornee or not adornee:IsA("BasePart") then return end

    removeNametag(character)
    local billboard = Instance.new("BillboardGui")
    billboard.Name = NAMETAG_GUI_NAME
    billboard.Adornee = adornee
    billboard.AlwaysOnTop = true
    billboard.LightInfluence = 0
    billboard.MaxDistance = 10000
    billboard.Size = UDim2.new(0, 220, 0, 42)
    billboard.StudsOffset = Vector3.new(0, 2.8, 0)
    billboard.Parent = character

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Name = "NameText"
    nameLabel.BackgroundTransparency = 1
    nameLabel.Size = UDim2.new(1, 0, 1, 0)
    nameLabel.Position = UDim2.new(0, 0, 0, 0)
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.Text = targetPlayer.DisplayName .. "  (@" .. targetPlayer.Name .. ")"
    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLabel.TextStrokeColor3 = Color3.fromRGB(20, 35, 55)
    nameLabel.TextStrokeTransparency = 0.15
    nameLabel.TextSize = 14
    nameLabel.TextScaled = false
    nameLabel.TextWrapped = true
    nameLabel.Parent = billboard
end

local function setNametagsEnabled(enabled)
    nametagEnabled = enabled
    if enabled then
        for _, targetPlayer in ipairs(Players:GetPlayers()) do
            addNametag(targetPlayer)
            if targetPlayer ~= player and not nametagPlayerConnections[targetPlayer] then
                nametagPlayerConnections[targetPlayer] = targetPlayer.CharacterAdded:Connect(function(character)
                    task.wait(0.5)
                    if nametagEnabled then addNametag(targetPlayer) end
                end)
            end
        end
        if not nametagAddedConnection then
            nametagAddedConnection = Players.PlayerAdded:Connect(function(targetPlayer)
                if targetPlayer == player then return end
                nametagPlayerConnections[targetPlayer] = targetPlayer.CharacterAdded:Connect(function()
                    task.wait(0.5)
                    if nametagEnabled then addNametag(targetPlayer) end
                end)
                task.defer(function() addNametag(targetPlayer) end)
            end)
        end
        if not nametagRemovingConnection then
            nametagRemovingConnection = Players.PlayerRemoving:Connect(function(targetPlayer)
                if targetPlayer.Character then removeNametag(targetPlayer.Character) end
                local connection = nametagPlayerConnections[targetPlayer]
                if connection then connection:Disconnect() end
                nametagPlayerConnections[targetPlayer] = nil
            end)
        end
    else
        for _, targetPlayer in ipairs(Players:GetPlayers()) do
            if targetPlayer.Character then removeNametag(targetPlayer.Character) end
        end
        for targetPlayer, connection in pairs(nametagPlayerConnections) do
            connection:Disconnect()
            nametagPlayerConnections[targetPlayer] = nil
        end
    end
end

